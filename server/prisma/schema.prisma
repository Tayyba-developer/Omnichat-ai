generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A business (merchant) in the OmniChat platform.
model Business {
  id           String        @id @default(uuid())
  name         String
  websiteUrl   String?       @map("websiteUrl")
  createdAt    DateTime      @default(now()) @map("createdAt")
  widgets      Widget[]
  catalogItems CatalogItem[]

  @@map("Business")
}

/// An embeddable chat widget owned by a Business.
model Widget {
  id            String         @id @default(uuid())
  businessId    String         @map("businessId")
  name          String
  configJson    String         @default("{}") @map("configJson")
  business      Business       @relation(fields: [businessId], references: [id])
  conversations Conversation[]

  @@map("Widget")
}

/// A single line-item in a business catalog.
model CatalogItem {
  id          String  @id @default(uuid())
  businessId  String  @map("businessId")
  name        String
  price       Float?
  imageUrl    String? @map("imageUrl")
  url         String?
  description String?
  business    Business @relation(fields: [businessId], references: [id])

  @@map("CatalogItem")
}

/// A conversation between a visitor and the AI widget.
model Conversation {
  id          String   @id @default(uuid())
  widgetId    String?  @map("widgetId")
  visitorId   String?  @map("visitorId")
  messagesJson String? @map("messagesJson")
  createdAt   DateTime @default(now())
  widget      Widget?  @relation(fields: [widgetId], references: [id])

  @@map("Conversation")
}
